# Local development only. Keep the password in sync when creating a new Docker volume.
POSTGRES_USER=freelink
POSTGRES_PASSWORD=freelink_dev
POSTGRES_DB=freelink
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://freelink:freelink_dev@127.0.0.1:5432/freelink

# Sepolia Escrow v2. Use the address exported for the frontend and a server-side RPC URL.
ESCROW_CHAIN_ID=11155111
# ESCROW_CONTRACT_ADDRESS=0x...
# ESCROW_THB_PER_ETH=1000000
# ESCROW_RPC_URL=https://your-sepolia-rpc
# Unset waits for finalized blocks (about 15 minutes on Sepolia). Set 3 for a testnet demo (about 40 seconds).
# ESCROW_CONFIRMATIONS=3

# Must match the browser's address exactly, with no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=
# Set to true behind HTTPS.
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
